# Tradestaar Elite — environment configuration template
# Copy to .env (local dev) or set these in your Render dashboard (prod).
# Values here are placeholders — replace every one before use.

# ---------------------------------------------------------------- REQUIRED
# Flask session signing. Startup BLOCKS without this. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Admin login password. If the users table is empty and neither APP_PASSWORD
# nor LOGIN_PASS is set, the app crash-loops in production (fail-closed).
APP_PASSWORD=change-me-to-a-strong-admin-password
# LOGIN_PASS=            # legacy alias for APP_PASSWORD

# Postgres connection string. Without it the app falls back to local SQLite
# (rockkstaar.db), which is WIPED on every Render restart/deploy.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------- MARKET DATA (at least one recommended)
FINNHUB_API_KEY=
NEWS_API_KEY=
POLYGON_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
# Alpaca (alternate data source; either pair works)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
ALPACA_MARKET_DATA_FEED=iex

# ---------------------------------------------------------------- AI / RESEARCH
ANTHROPIC_API_KEY=
ANTHROPIC_BRIEFING_MODEL=claude-sonnet-4-20250514
NEBIUS_API_KEY=
NEBIUS_BRIEFING_MODEL=
TRADESTAAR_TAKE_API_KEY=
TRADESTAAR_TAKE_MODEL=gpt-5-mini
TRADESTAAR_TAKE_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------- BROKER INTEGRATIONS
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ---------------------------------------------------------------- ALERTS: TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

# ---------------------------------------------------------------- ALERTS: SMS (Twilio)
SMS_ALERTS_ENABLED=false
SMS_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# ...or API key pair instead of AUTH_TOKEN:
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------- ALERTS: WEB PUSH / DISCORD
BROWSER_PUSH_ENABLED=false
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_ENCRYPTION_KEY=
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------- APP BEHAVIOR
APP_ENV=production
APP_USER=admin
APP_PASS=                    # legacy alias; prefer APP_PASSWORD
ALLOW_REGISTRATION=false
PORT=10000
RENDER=true
TRADESTAAR_DB_PATH=
TRADESTAAR_NO_BACKGROUND=0
INSIDER_LARGE_SALE_USD=1000000
CONGRESS_TRADES_JSON_URL=

# Live research runner tuning
LIVE_RESEARCH_AUTO_PUBLISH=false
LIVE_RESEARCH_AUTO_PUBLISH_LIMIT=
LIVE_RESEARCH_AUTO_PUBLISH_MAX_AGE_HOURS=
LIVE_RESEARCH_RECENCY_HOURS=
LIVE_RESEARCH_SAMPLE=
LIVE_RESEARCH_TICKERS=
